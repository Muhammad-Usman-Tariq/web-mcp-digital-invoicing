# ==============================================================================
# Environment Configuration: digital-invoice-web
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Central Auth Server Settings
# JWKS URI for token signature validation (RS256)
JWKS_URI=h

# Audience MUST match registered value in Central Auth (distinct from digital-invoice-api)
MCP_AUTH_AUDIENCE=digi

# Optional Central Auth Revocations endpoint
REVOCATIONS_URI=https:

# Supabase (Database & RLS)
SUPABASE_URL=https://your-supabase-project.supabase.co
# Service role key is required for backend operations (bypasses RLS server-side)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cryptography (AES-256-GCM)
# 64-character hex string generated via: python scripts/generate_master_key.py
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CURRENT_KEY_VERSION=1

# Browser Automation (Playwright)
PORTAL_BASE_URL=https://www.digitalinvoicingsoftware.com
HEADLESS=true
SLOW_MO_MS=500
MAX_CONCURRENT_BROWSERS=3
NAVIGATION_TIMEOUT_MS=20000
ACTION_TIMEOUT_MS=15000
SESSION_TTL_HOURS=24
